+// Llamar con g_nba_ring_mutex tomado.
+static void DumpNbaTraceFile(const CONTEXT* c) {
+    FILE* f = std::fopen("nba_crash.txt", "w");
+    if (f == nullptr) {
+        return;
+    }
+    std::fprintf(f, "NBA-CRASH thread=%lu rip=%#llx (volcado %#llx) rax=%#llx rbx=%#llx rdi=%#llx\n",
+                 GetCurrentThreadId(), c->Rip, c->Rip - g_nba_dump_delta, c->Rax, c->Rbx, c->Rdi);
+    const size_t n = std::min(g_nba_ring_pos, g_nba_ring.size());
+    for (size_t i = g_nba_ring_pos - n; i < g_nba_ring_pos; i++) {
+        const NbaTraceEntry& e = g_nba_ring[i % g_nba_ring.size()];
+        if (e.kind == 3) {
+            std::fprintf(f,
+                         "%zu MARK %#llx rdi=%#llx rsi=%#llx rax=%#llx rbx=%#llx rcx=%#llx [rdi]=%#llx "
+                         "o0=%#llx o1=%#llx o2=%#llx o3=%#llx thread=%llu\n",
+                         i, e.a - g_nba_dump_delta, e.b, e.c, e.e, e.f, e.g, e.h, e.r28, e.r30, e.r78,
+                         e.r178, e.d);
+        } else if (e.kind == 2 && g_nba_ring_pos - i <= 3000) {
+            std::fprintf(f, "%zu LOG \"%s\" %#llx [%s] %#llx [%s] %#llx [%s]\n", i,
+                         NbaTraceText(e.a).c_str(), e.b, NbaTraceText(e.b).c_str(), e.c,
+                         NbaTraceText(e.c).c_str(), e.d, NbaTraceText(e.d).c_str());
+        }
+    }
