 namespace Libraries::Net {
 
+// NBA-DIAG: servidor de juego dedicado de la comunidad (ver tambien p2p_transport.cpp).
+// NBA_GSRV=ip:puerto=ip:puerto (virtual=real): el socket UDP de CommUDP del juego manda a la direccion
+// virtual que anuncia el servidor Blaze (con el puerto de juego de ConnApi); aqui se envia a la real y
+// lo que llega de la real se le presenta como de la virtual.
+struct GameServerRedirect {
+    sockaddr_in virt{};
+    sockaddr_in real{};
+};
+
+static const std::optional<GameServerRedirect>& GetGameServerRedirect() {
+    static const std::optional<GameServerRedirect> redirect = []() -> std::optional<GameServerRedirect> {
+        const char* v = std::getenv("NBA_GSRV");
+        if (v == nullptr) {
+            return std::nullopt;
+        }
+        const std::string text{v};
+        const auto eq = text.find('=');
+        const auto parse = [](const std::string& part, sockaddr_in* out) {
+            const auto colon = part.rfind(':');
+            if (colon == std::string::npos) {
+                return false;
+            }
+            out->sin_family = AF_INET;
+            out->sin_port = htons(static_cast<u16>(std::atoi(part.c_str() + colon + 1)));
+            return inet_pton(AF_INET, part.substr(0, colon).c_str(), &out->sin_addr) == 1;
+        };
+        GameServerRedirect r;
+        if (eq == std::string::npos || !parse(text.substr(0, eq), &r.virt) ||
+            !parse(text.substr(eq + 1), &r.real)) {
+            LOG_WARNING(Lib_Net, "NBA-GSRV: bad value {}", text);
+            return std::nullopt;
+        }
+        LOG_INFO(Lib_Net, "NBA-GSRV: {} -> {}", text.substr(0, eq), text.substr(eq + 1));
+        return r;
+    }();
+    return redirect;
+}
+
+static bool SameIPv4(const sockaddr_in& a, const sockaddr_storage& b) {
+    if (b.ss_family != AF_INET) {
+        return false;
+    }
+    const auto& in = reinterpret_cast<const sockaddr_in&>(b);
+    return in.sin_port == a.sin_port && in.sin_addr.s_addr == a.sin_addr.s_addr;
+}
