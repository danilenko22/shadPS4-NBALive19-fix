+// Llamar con g_nba_ring_mutex tomado.
+static void DumpNbaTrace() {
+    const size_t n = std::min(g_nba_ring_pos, g_nba_ring.size());
+    for (size_t i = g_nba_ring_pos - n; i < g_nba_ring_pos; i++) {
+        const NbaTraceEntry& e = g_nba_ring[i % g_nba_ring.size()];
+        // Las marcas se vuelcan todas; del resto, solo las ultimas 3000 entradas
+        if (e.kind != 3 && g_nba_ring_pos - i > 3000) {
+            continue;
+        }
+        if (e.kind == 0) {
+            LOG_INFO(Debug, "NBA-TRACE {} {}.{}", i, NbaTraceText(e.a), NbaTraceText(e.b));
+        } else if (e.kind == 1) {
+            LOG_INFO(Debug, "NBA-TRACE {}     -> {:#x}", i, e.a);
+        } else if (e.kind == 3) {
+            LOG_INFO(Debug, "NBA-TRACE {} MARK {:#x} rdi={:#x} rsi={:#x} rax={:#x} rbx={:#x} rcx={:#x} [rdi]={:#x} thread={}", i,
+                     e.a - g_nba_dump_delta, e.b, e.c, e.e, e.f, e.g, e.h, e.d);
+        } else {
+            LOG_INFO(Debug, "NBA-TRACE {} LOG \"{}\" args: {:#x} [{}] {:#x} [{}] {:#x} [{}]", i,
+                     NbaTraceText(e.a), e.b, NbaTraceText(e.b), e.c, NbaTraceText(e.c), e.d,
+                     NbaTraceText(e.d));
+        }
+    }
