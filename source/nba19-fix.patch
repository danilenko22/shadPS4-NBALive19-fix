+// NBA-DIAG: servidor de juego dedicado de la comunidad. NBA_GSRV=ip:puerto=ip:puerto (virtual=real):
+// lo que el juego manda a la direccion virtual (la que anuncia el servidor Blaze, con el puerto de
+// juego de ConnApi) sale hacia la real, y lo que llega de la real se le presenta como de la virtual.
+// Sin esto, con el servidor en la IP de un jugador, ConnApi acaba hablando con el juego de ese PC.
+std::optional<std::pair<Endpoint, Endpoint>> GameServerRedirect() {
+    static const auto redirect = []() -> std::optional<std::pair<Endpoint, Endpoint>> {
+        const char* v = std::getenv("NBA_GSRV");
+        if (v == nullptr) {
+            return std::nullopt;
+        }
+        const std::string text{v};
+        const auto eq = text.find('=');
+        const auto parse = [](const std::string& part) -> std::optional<Endpoint> {
+            const auto colon = part.rfind(':');
+            if (colon == std::string::npos) {
+                return std::nullopt;
+            }
+            const std::string ip = part.substr(0, colon);
+            return Endpoint::IPv4(ip.c_str(), static_cast<u16>(std::atoi(part.c_str() + colon + 1)));
+        };
+        if (eq == std::string::npos) {
+            return std::nullopt;
+        }
+        const auto virt = parse(text.substr(0, eq));
+        const auto real = parse(text.substr(eq + 1));
+        if (!virt || !real) {
+            return std::nullopt;
+        }
+        LOG_INFO(Lib_Net, "NBA-GSRV: {} -> {}", text.substr(0, eq), text.substr(eq + 1));
+        return std::make_pair(*virt, *real);
+    }();
+    return redirect;
+}
