+// NBA-DIAG: anillo de la traza (modo NBA_PROBE_TRACE). Se vuelca con un acierto en DR1 y
+// tambien al morir el juego por una excepcion no manejada.
+struct NbaTraceEntry {
+    int kind; // 0 nativa (adaptador, nombre), 1 booleano devuelto, 2 mensaje de log, 3 marca
+    u64 a, b, c, d, e, f, g, h; // h: primer qword en [rdi] (vtable si rdi es un objeto)
+    u64 r28, r30, r78, r178;    // qwords en [rdi+0x28], [rdi+0x30], [rdi+0x78], [rdi+0x178]
+};
+static std::mutex g_nba_ring_mutex;
+static std::array<NbaTraceEntry, 65536> g_nba_ring{};
+static size_t g_nba_ring_pos = 0;
+// Traza automatica (StartNbaAutoTrace): marcas en DR0/DR1/DR3 (direcciones del volcado)
+static bool g_nba_auto_marks = false;
+static u64 g_nba_dump_delta = 0; // direccion en ejecucion - direccion del volcado
+
+// Lee una cadena solo si la pagina es legible (los argumentos pueden no ser punteros)
+static std::string NbaTraceText(u64 p) {
+    MEMORY_BASIC_INFORMATION mbi{};
+    if (p < 0x10000 || VirtualQuery(reinterpret_cast<void*>(p), &mbi, sizeof(mbi)) == 0 ||
+        mbi.State != MEM_COMMIT || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0) {
+        return {};
+    }
+    const auto* s = reinterpret_cast<const char*>(p);
+    const auto end = reinterpret_cast<const char*>(mbi.BaseAddress) + mbi.RegionSize;
+    std::string out;
+    for (; s < end && *s != 0 && out.size() < 160; ++s) {
+        if (*s < 0x20 || *s > 0x7e) {
+            return {};
+        }
+        out += *s;
+    }
+    return out;
+}
+
+// Primer qword en addr si la memoria es legible (0 si no): con rdi = objeto, su vtable.
+// NBA_MARK_OFFS=a,b,c,d (hex): desplazamientos desde rdi que leen las marcas (por defecto 28,30,78,178).
+static std::array<u64, 4> g_nba_mark_offs{0x28, 0x30, 0x78, 0x178};
+
+static u64 NbaReadQword(u64 addr) {
+    MEMORY_BASIC_INFORMATION mbi{};
+    if (addr < 0x10000 || VirtualQuery(reinterpret_cast<void*>(addr), &mbi, sizeof(mbi)) == 0 ||
+        mbi.State != MEM_COMMIT || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) != 0) {
+        return 0;
+    }
+    return *reinterpret_cast<const u64*>(addr);
