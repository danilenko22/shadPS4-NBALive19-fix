index 605fcf36..cb4e1281 100644
--- a/src/core/cpu_patches.cpp
+++ b/src/core/cpu_patches.cpp
@@ -2477,7 +2477,387 @@ void RegisterPatchModule(void* module_ptr, u64 module_size, void* trampoline_are
                                           trampoline_area_size));
 }
 
+#if defined(_WIN32)
+// NBA LIVE 19 online: en Windows no hay parcheo previo y RCPPS/RSQRTPS (y sus formas VEX) son legales en
+// Intel, asi que nunca pasan por el manejador de instrucciones ilegales: el juego usaba los resultados
+// aproximados de Intel mientras una CPU AMD da otros, y en el online por entradas (NetGameDist) las dos
+// simulaciones divergian (Online::DesyncDetector). Aqui se parchean por adelantado para dar el resultado
+// de AMD. Casi todas miden 4 bytes (no cabe el salto de 5), asi que se lleva al trampolin tambien la
+// instruccion vecina (la siguiente o, si no se puede, la anterior), siempre que no sea destino de un
+// salto directo ni controle el flujo; los desplazamientos relativos a RIP se recalculan.
+static bool IsReciprocalMnemonic(ZydisMnemonic m) {
+    return m == ZYDIS_MNEMONIC_RCPPS || m == ZYDIS_MNEMONIC_RSQRTPS || m == ZYDIS_MNEMONIC_VRCPPS ||
+           m == ZYDIS_MNEMONIC_VRSQRTPS;
+}
+
+/// Modo de los reciprocos: exacto (por defecto; 1/x y 1/raiz(x) IEEE, mismo resultado en cualquier
+/// CPU, asi juegan juntos Intel y AMD de cualquier generacion) o amd (NBA_RCP_MODO=amd: solo en
+/// Intel, imita el resultado aproximado de AMD con las tablas de shadPS4, como en la PS4).
+static bool ReciprocalExactMode() {
+    static const bool exact = [] {
+        const char* m = std::getenv("NBA_RCP_MODO");
+        return m == nullptr || std::string_view{m} != "amd";
+    }();
+    return exact;
+}
+
+/// VRCPPS/VRSQRTPS -> resultado exacto: dst = 1/src o 1/raiz(src) con VDIVPS/VSQRTPS. Conserva todos
+/// los registros salvo dst (usa dos vectores y RAX de apoyo, guardados por debajo de la red zone) y
+/// no toca los flags.
+static void GenerateExactReciprocal(void* address, const ZydisDecodedInstruction& instruction,
+                                    const ZydisDecodedOperand* operands, Xbyak::CodeGenerator& c,
+                                    bool rsqrt) {
+    const auto dst = ZydisToXbyakRegisterOperand(operands[0]);
+    ASSERT_MSG(dst.isXMM() || dst.isYMM(), "operand 0 must be an XMM or YMM register");
+    const bool is_src_mem = operands[1].type == ZYDIS_OPERAND_TYPE_MEMORY;
+
+    std::array<bool, 16> taken{};
+    taken[dst.getIdx()] = true;
+    Xbyak::Xmm src_reg;
+    if (!is_src_mem) {
+        const auto src = ZydisToXbyakRegisterOperand(operands[1]);
+        taken[src.getIdx()] = true;
+        src_reg = Xbyak::Xmm(dst.getKind(), src.getIdx());
+    }
+    const auto it1 = std::find(taken.begin(), taken.end(), false);
+    const auto it2 = std::find(std::next(it1), taken.end(), false);
+    const int one_idx = static_cast<int>(it1 - taken.begin());
+    const int val_idx = static_cast<int>(it2 - taken.begin());
+    const Xbyak::Xmm dst_reg(dst.getKind(), dst.getIdx());
+    const Xbyak::Xmm one(dst.getKind(), one_idx);
+    const Xbyak::Xmm val(dst.getKind(), val_idx);
+
+    const int rsp_disp = 128 + 64;
+    c.lea(rsp, ptr[rsp - rsp_disp]);
+    c.vmovups(ptr[rsp], one.cvt256());
+    c.vmovups(ptr[rsp + 32], val.cvt256());
+    c.push(rax);
+    if (is_src_mem) {
+        if (operands[1].mem.base == ZYDIS_REGISTER_RIP) {
+            const u64 target = (u64)address + instruction.length + operands[1].mem.disp.value;
+            c.mov(rax, target);
+            c.vmovups(val, ptr[rax]);
+        } else {
+            ZydisDecodedOperand operand = operands[1];
+            if (operands[1].mem.base == ZYDIS_REGISTER_RSP) {
+                operand.mem.disp.size = 32;
+                operand.mem.disp.value += rsp_disp + 8; // lo que se reservo + RAX
+            }
+            c.vmovups(val, ZydisToXbyakMemoryOperand(operand));
+        }
+    } else {
+        c.vmovaps(val, src_reg);
+    }
+    if (rsqrt) {
+        c.vsqrtps(val, val);
+    }
+    c.mov(eax, 0x3f800000); // 1.0f
+    c.vmovd(Xbyak::Xmm(one_idx), eax);
+    c.vbroadcastss(one, Xbyak::Xmm(one_idx));
+    c.vdivps(one, one, val);
+    c.vmovaps(dst_reg, one);
+    c.pop(rax);
+    c.vmovups(val.cvt256(), ptr[rsp + 32]);
+    c.vmovups(one.cvt256(), ptr[rsp]);
+    c.lea(rsp, ptr[rsp + rsp_disp]);
+}
+
+struct SweptInstruction {
+    u8* code;
+    ZydisDecodedInstruction instruction;
+    ZydisDecodedOperand operands[ZYDIS_MAX_OPERAND_COUNT];
+    bool flow;
+};
+
+static bool IsFlowInstruction(const ZydisDecodedInstruction& ins) {
+    switch (ins.meta.category) {
+    case ZYDIS_CATEGORY_COND_BR:
+    case ZYDIS_CATEGORY_UNCOND_BR:
+    case ZYDIS_CATEGORY_CALL:
+    case ZYDIS_CATEGORY_RET:
+    case ZYDIS_CATEGORY_SYSCALL:
+    case ZYDIS_CATEGORY_INTERRUPT:
+    case ZYDIS_CATEGORY_SYSTEM:
+        return true;
+    default:
+        // Ojo: ZYDIS_ATTRIB_IS_RELATIVE tambien marca los accesos a memoria relativos a RIP.
+        return false;
+    }
+}
+
+static const ZydisDecodedOperand* RelativeImmediate(const SweptInstruction& s) {
+    for (u32 i = 0; i < s.instruction.operand_count; i++) {
+        if (s.operands[i].type == ZYDIS_OPERAND_TYPE_IMMEDIATE && s.operands[i].imm.is_relative) {
+            return &s.operands[i];
+        }
+    }
+    return nullptr;
+}
+
+/// Emite en el trampolin el equivalente de una instruccion movida: el reciproco emulado o una copia
+/// con el desplazamiento RIP corregido. Devuelve false si no se puede reubicar.
+static bool EmitRelocated(const SweptInstruction& s, Xbyak::CodeGenerator& c) {
+    const auto& ins = s.instruction;
+    if (IsReciprocalMnemonic(ins.mnemonic)) {
+        const bool rsqrt =
+            ins.mnemonic == ZYDIS_MNEMONIC_RSQRTPS || ins.mnemonic == ZYDIS_MNEMONIC_VRSQRTPS;
+        const bool vex = ins.mnemonic == ZYDIS_MNEMONIC_VRSQRTPS || ins.mnemonic == ZYDIS_MNEMONIC_VRCPPS;
+        if (ReciprocalExactMode()) {
+            GenerateExactReciprocal(s.code, ins, s.operands, c, rsqrt);
+        } else {
+            GenerateReciprocalInstruction(s.code, ins, s.operands, c, rsqrt, vex);
+        }
+        return true;
+    }
+    if (const auto* rel = RelativeImmediate(s)) {
+        // Salto/llamada relativos: se reescriben con el destino absoluto.
+        const void* target = s.code + ins.length + rel->imm.value.s;
+        using LT = Xbyak::CodeGenerator::LabelType;
+        switch (ins.mnemonic) {
+        case ZYDIS_MNEMONIC_JMP: c.jmp(target, LT::T_NEAR); return true;
+        case ZYDIS_MNEMONIC_CALL: c.call(target); return true;
+        case ZYDIS_MNEMONIC_JB: c.jb(target); return true;
+        case ZYDIS_MNEMONIC_JBE: c.jbe(target); return true;
+        case ZYDIS_MNEMONIC_JL: c.jl(target); return true;
+        case ZYDIS_MNEMONIC_JLE: c.jle(target); return true;
+        case ZYDIS_MNEMONIC_JNB: c.jnb(target); return true;
+        case ZYDIS_MNEMONIC_JNBE: c.jnbe(target); return true;
+        case ZYDIS_MNEMONIC_JNL: c.jnl(target); return true;
+        case ZYDIS_MNEMONIC_JNLE: c.jnle(target); return true;
+        case ZYDIS_MNEMONIC_JNO: c.jno(target); return true;
+        case ZYDIS_MNEMONIC_JNP: c.jnp(target); return true;
+        case ZYDIS_MNEMONIC_JNS: c.jns(target); return true;
+        case ZYDIS_MNEMONIC_JNZ: c.jnz(target); return true;
+        case ZYDIS_MNEMONIC_JO: c.jo(target); return true;
+        case ZYDIS_MNEMONIC_JP: c.jp(target); return true;
+        case ZYDIS_MNEMONIC_JS: c.js(target); return true;
+        case ZYDIS_MNEMONIC_JZ: c.jz(target); return true;
+        default: return false;
+        }
+    }
+    bool rip_relative = false;
+    for (u32 i = 0; i < ins.operand_count; i++) {
+        if (s.operands[i].type == ZYDIS_OPERAND_TYPE_MEMORY &&
+            s.operands[i].mem.base == ZYDIS_REGISTER_RIP) {
+            rip_relative = true;
+        }
+    }
+    u8 bytes[ZYDIS_MAX_INSTRUCTION_LENGTH];
+    std::memcpy(bytes, s.code, ins.length);
+    if (rip_relative) {
+        if (ins.raw.disp.size != 32) {
+            return false;
+        }
+        const s64 target = reinterpret_cast<s64>(s.code) + ins.length + ins.raw.disp.value;
+        const s64 new_disp = target - (reinterpret_cast<s64>(c.getCurr()) + ins.length);
+        if (new_disp < INT32_MIN || new_disp > INT32_MAX) {
+            return false;
+        }
+        const s32 disp32 = static_cast<s32>(new_disp);
+        std::memcpy(bytes + ins.raw.disp.offset, &disp32, sizeof(disp32));
+    }
+    for (u32 i = 0; i < ins.length; i++) {
+        c.db(bytes[i]);
+    }
+    return true;
+}
+
+static void RcpDebug(const char* fmt_str, const void* a, u64 b) {
+    static FILE* f = std::getenv("NBA_RCP_DEBUG") ? std::fopen("nba_rcp_debug.txt", "w") : nullptr;
+    if (f) {
+        std::fprintf(f, fmt_str, a, static_cast<unsigned long long>(b));
+        std::fputc(10, f);
+        std::fflush(f);
+    }
+}
+
+static void PrePatchReciprocalsWindows(u8* start, u64 size) {
+    if (std::getenv("NBA_NO_RCP_PATCH") != nullptr ||
+        (!ReciprocalExactMode() && !FilterIntelCPU(nullptr))) {
+        return;
+    }
+    RcpDebug("inicio %p tam %llu", start, size);
+    auto* module = GetModule(start);
+    if (module == nullptr) {
+        return;
+    }
+    std::unique_lock lock{module->mutex};
+    u8* const end = std::min(start + size, module->end);
+
+    // Pasada 1: barrido lineal. Solo se guarda lo imprescindible de cada instruccion (son millones).
+    struct Compact {
+        u8* code;
+        u8 length;
+        bool flow;
+        bool recip;
+        bool movable_flow; // salto/llamada/ret que EmitRelocated sabe llevar al trampolin
+    };
+    std::vector<Compact> list;
+    list.reserve(size / 4);
+    std::unordered_set<u8*> targets;
+    {
+        ZydisDecodedInstruction ins;
+        ZydisDecodedOperand ops[ZYDIS_MAX_OPERAND_COUNT];
+        for (u8* p = start; p < end;) {
+            const auto status =
+                Common::Decoder::Instance()->decodeInstruction(ins, ops, p, end - p);
+            if (!ZYAN_SUCCESS(status)) {
+                p++;
+                continue;
+            }
+            if ((ins.attributes & ZYDIS_ATTRIB_IS_RELATIVE) != 0) {
+                for (u32 k = 0; k < ins.operand_count; k++) {
+                    if (ops[k].type == ZYDIS_OPERAND_TYPE_IMMEDIATE && ops[k].imm.is_relative) {
+                        targets.insert(p + ins.length + ops[k].imm.value.s);
+                    }
+                }
+            }
+            // Solo las formas VEX: el juego no usa RCPPS/RSQRTPS sin VEX y las que aparecen son datos
+            // decodificados por el barrido lineal.
+            const bool recip =
+                ins.mnemonic == ZYDIS_MNEMONIC_VRCPPS || ins.mnemonic == ZYDIS_MNEMONIC_VRSQRTPS;
+            const auto cat = ins.meta.category;
+            const bool movable_flow = cat == ZYDIS_CATEGORY_COND_BR || cat == ZYDIS_CATEGORY_UNCOND_BR ||
+                                      cat == ZYDIS_CATEGORY_CALL || cat == ZYDIS_CATEGORY_RET;
+            list.push_back({p, ins.length, IsFlowInstruction(ins), recip, movable_flow});
+            p += ins.length;
+        }
+    }
+    RcpDebug("pasada 1 hecha %p instrucciones %llu", start, list.size());
+    const auto decode = [end](const Compact& c, SweptInstruction& s) {
+        s.code = c.code;
+        s.flow = c.flow;
+        return ZYAN_SUCCESS(Common::Decoder::Instance()->decodeInstruction(
+            s.instruction, s.operands, c.code, end - c.code));
+    };
+
+    // Pasada 2: parcheo.
+    u32 patched = 0, skipped = 0;
+    std::vector<bool> done(list.size(), false);
+    auto& tg = module->trampoline_gen;
+    for (size_t i = 0; i < list.size(); i++) {
+        const auto& s = list[i];
+        if (done[i] || !s.recip) {
+            continue;
+        }
+        if (s.length >= NearJumpSize) {
+            // Cabe el salto: trampolin solo con el reciproco.
+            SweptInstruction single{};
+            bool ok = decode(s, single);
+            const size_t tramp_offset = tg.getSize();
+            void* const tramp_ptr = const_cast<u8*>(tg.getCurr());
+            try {
+                if (ok) {
+                    ok = EmitRelocated(single, tg);
+                    tg.jmp(s.code + s.length);
+                }
+                if (ok) {
+                    auto& pg = module->patch_gen;
+                    pg.reset();
+                    pg.setSize(s.code - pg.getCode());
+                    pg.jmp(tramp_ptr, Xbyak::CodeGenerator::LabelType::T_NEAR);
+                    pg.nop(s.length - (pg.getCurr() - s.code));
+                    module->patched.insert(s.code);
+                }
+            } catch (const Xbyak::Error& error) {
+                tg.setSize(tramp_offset);
+                LOG_ERROR(Core, "NBA: reciproco en {} sin parchear: {}", fmt::ptr(s.code),
+                          error.what());
+                ok = false;
+            }
+            ok ? patched++ : skipped++;
+            done[i] = true;
+            continue;
+        }
+        // Pareja: (primera, segunda) contiguas; el salto va al principio de la primera.
+        const Compact* cfirst = nullptr;
+        const Compact* csecond = nullptr;
+        size_t other = 0;
+        if (i + 1 < list.size()) {
+            const auto& n = list[i + 1];
+            if (n.code == s.code + s.length && (!n.flow || n.movable_flow) &&
+                !targets.contains(n.code) && !done[i + 1]) {
+                cfirst = &s, csecond = &n, other = i + 1;
+            }
+        }
+        if (cfirst == nullptr && i > 0) {
+            const auto& pv = list[i - 1];
+            if (pv.code + pv.length == s.code && !pv.flow && !targets.contains(s.code) &&
+                !done[i - 1] && !module->patched.contains(pv.code)) {
+                cfirst = &pv, csecond = &s, other = i - 1;
+            }
+        }
+        SweptInstruction sfirst{}, ssecond{};
+        if (cfirst == nullptr) {
+            const bool nf = i + 1 < list.size() && list[i + 1].flow;
+            const bool nt = i + 1 < list.size() && targets.contains(list[i + 1].code);
+            const bool pf = i > 0 && list[i - 1].flow;
+            const bool st = targets.contains(s.code);
+            RcpDebug("SIN PAREJA %p motivo %llu", s.code, (nf ? 1 : 0) | (nt ? 2 : 0) | (pf ? 4 : 0) |
+                                                          (st ? 8 : 0));
+        }
+        if (cfirst == nullptr || !decode(*cfirst, sfirst) || !decode(*csecond, ssecond)) {
+            skipped++;
+            done[i] = true;
+            continue;
+        }
+        const SweptInstruction* first = &sfirst;
+        const SweptInstruction* second = &ssecond;
+        const size_t tramp_offset = tg.getSize();
+        void* const tramp_ptr = const_cast<u8*>(tg.getCurr());
+        bool ok = false;
+        try {
+            ok = EmitRelocated(*first, tg) && EmitRelocated(*second, tg);
+            if (ok) {
+                tg.jmp(second->code + second->instruction.length);
+            }
+        } catch (const Xbyak::Error& error) {
+            tg.setSize(tramp_offset);
+            if (HandleTrampolineError(module, error)) {
+                break;
+            }
+            LOG_ERROR(Core, "NBA: reciproco en {} sin parchear: {}", fmt::ptr(s.code), error.what());
+            ok = false;
+        }
+        if (!ok) {
+            tg.setSize(tramp_offset);
+            skipped++;
+            done[i] = true;
+            continue;
+        }
+        auto& pg = module->patch_gen;
+        try {
+            pg.reset();
+            pg.setSize(first->code - pg.getCode());
+            pg.jmp(tramp_ptr, Xbyak::CodeGenerator::LabelType::T_NEAR);
+            const u64 total = first->instruction.length + second->instruction.length;
+            pg.nop(total - (pg.getCurr() - first->code));
+        } catch (const Xbyak::Error& error) {
+            LOG_ERROR(Core, "NBA: salto en {} no escrito: {}", fmt::ptr(first->code), error.what());
+            skipped++;
+            done[i] = true;
+            continue;
+        }
