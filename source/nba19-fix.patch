+// Copia continua del log del juego y las marcas a nba_trace.txt (carpeta actual), para ver lo que
+// hace el juego aunque no se caiga. Cada formato se escribe como mucho 300 veces (hay mensajes que
+// se repiten en cada fotograma).
+static void FlushNbaTraceFile() {
+    static size_t done = 0;
+    static std::unordered_map<u64, u32> seen;
+    static FILE* f = std::fopen("nba_trace.txt", "w");
+    if (f == nullptr) {
+        return;
+    }
+    std::vector<std::pair<size_t, NbaTraceEntry>> news;
+    {
+        std::scoped_lock lk{g_nba_ring_mutex};
+        if (g_nba_ring_pos - done > g_nba_ring.size()) {
+            done = g_nba_ring_pos - g_nba_ring.size();
+        }
+        for (; done < g_nba_ring_pos; ++done) {
+            const NbaTraceEntry& e = g_nba_ring[done % g_nba_ring.size()];
+            if ((e.kind == 3 || e.kind == 2) && seen[e.a]++ < 300) {
+                news.emplace_back(done, e);
+            }
+        }
+    }
+    const SYSTEMTIME now = [] {
+        SYSTEMTIME t;
+        GetLocalTime(&t);
+        return t;
+    }();
+    for (const auto& [i, e] : news) {
+        if (e.kind == 3) {
+            std::fprintf(f, "%02d:%02d:%02d %zu MARK %#llx rdi=%#llx rsi=%#llx rax=%#llx rbx=%#llx "
+                            "rcx=%#llx [rdi]=%#llx o0=%#llx o1=%#llx o2=%#llx o3=%#llx thread=%llu\n",
+                         now.wHour, now.wMinute, now.wSecond, i, e.a - g_nba_dump_delta, e.b, e.c,
+                         e.e, e.f, e.g, e.h, e.r28, e.r30, e.r78, e.r178, e.d);
+        } else {
+            std::fprintf(f, "%02d:%02d:%02d %zu LOG \"%s\" %#llx [%s] %#llx [%s] %#llx [%s]\n",
+                         now.wHour, now.wMinute, now.wSecond, i, NbaTraceText(e.a).c_str(), e.b,
+                         NbaTraceText(e.b).c_str(), e.c, NbaTraceText(e.c).c_str(), e.d,
+                         NbaTraceText(e.d).c_str());
+        }
+    }
+    std::fflush(f);
+}
