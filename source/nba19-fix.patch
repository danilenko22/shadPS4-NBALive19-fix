+void StartNbaAutoTrace(u64 eboot_base) {
+    const char* fn = std::getenv("NBA_TRACE_LOGFN");
+    if (fn == nullptr || std::getenv("NBA_PROBE_TRACE") == nullptr) {
+        return;
+    }
+    // Addresses come from the eboot dump, which was taken with the eboot at 0xB4D0000.
+    constexpr u64 DumpBase = 0xB4D0000;
+    g_nba_dump_delta = eboot_base - DumpBase;
+    const u64 target = std::strtoull(fn, nullptr, 16) + g_nba_dump_delta;
+    LOG_INFO(Debug, "NBA-TRACE: auto trace on log function {:#x}", target);
+    if (const char* o = std::getenv("NBA_MARK_OFFS")) {
+        char* p = const_cast<char*>(o);
+        for (auto& off : g_nba_mark_offs) {
+            off = std::strtoull(p, &p, 16);
+            if (*p != ',') {
+                break;
+            }
+            ++p;
+        }
+    }
+    // NBA_TRACE_MARKS=a,b,c: up to three functions whose entry is recorded in the ring (DR0, DR1,
+    // DR3), to see the order of events next to the game's log.
+    std::array<u64, 3> marks{};
+    if (const char* m = std::getenv("NBA_TRACE_MARKS")) {
+        char* p = const_cast<char*>(m);
+        for (auto& mark : marks) {
+            const u64 v = std::strtoull(p, &p, 16);
+            if (v == 0) {
+                break;
+            }
+            mark = v + g_nba_dump_delta;
+            LOG_INFO(Debug, "NBA-TRACE: mark on {:#x}", mark);
+            if (*p != ',') {
+                break;
+            }
+            ++p;
+        }
+        g_nba_auto_marks = marks[0] != 0;
+    }
+    std::thread([target, marks] {
+        const DWORD self = GetCurrentThreadId();
+        const DWORD pid = GetCurrentProcessId();
+        while (true) {
+            HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+            THREADENTRY32 te{};
+            te.dwSize = sizeof(te);
+            for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+                if (te.th32OwnerProcessID != pid || te.th32ThreadID == self) {
+                    continue;
+                }
+                HANDLE h = OpenThread(THREAD_GET_CONTEXT | THREAD_SET_CONTEXT |
+                                          THREAD_SUSPEND_RESUME,
+                                      FALSE, te.th32ThreadID);
+                if (h == nullptr) {
+                    continue;
+                }
+                // No logging while a thread is suspended: it could be holding the log lock.
+                if (SuspendThread(h) != static_cast<DWORD>(-1)) {
+                    CONTEXT c{};
+                    c.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+                    if (GetThreadContext(h, &c) && (c.Dr2 != target || c.Dr0 != marks[0] ||
+                                                     c.Dr1 != marks[1] || c.Dr3 != marks[2])) {
+                        // Execute breakpoints (RW=00, LEN=00); DR2 = log, DR0/DR1/DR3 = marks
+                        c.Dr0 = marks[0];
+                        c.Dr1 = marks[1];
+                        c.Dr2 = target;
+                        c.Dr3 = marks[2];
+                        u64 dr7 = c.Dr7 & ~u64{0xFFFF00FF};
+                        dr7 |= u64{1} << 4;
+                        if (marks[0] != 0) {
+                            dr7 |= u64{1} << 0;
+                        }
+                        if (marks[1] != 0) {
+                            dr7 |= u64{1} << 2;
+                        }
+                        if (marks[2] != 0) {
+                            dr7 |= u64{1} << 6;
+                        }
+                        c.Dr7 = dr7;
+                        SetThreadContext(h, &c);
+                    }
+                    ResumeThread(h);
+                }
+                CloseHandle(h);
+            }
+            CloseHandle(snap);
+            FlushNbaTraceFile();
+            Sleep(2000);
+        }
+    }).detach();
+}
