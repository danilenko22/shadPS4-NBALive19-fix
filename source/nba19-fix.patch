+
+// NBA-DIAG: sondas con breakpoints de hardware puestos desde fuera (tools/probe.py).
+// DR0-DR2 son sondas de entrada; DR3 se usa automaticamente para capturar el retorno
+// de la ultima funcion sondeada (registra RAX). Siempre se reanuda con RF=1.
+static bool HandleNbaProbe(EXCEPTION_POINTERS* pExp) {
+    CONTEXT* ctx = pExp->ContextRecord;
+    const u64 dr6 = ctx->Dr6;
+    if ((dr6 & 0xF) == 0) {
+        return false;
+    }
+    static std::mutex probe_mutex;
+    static std::unordered_map<u64, u64> probe_hits;
+    const u64 rip = ctx->Rip;
+    // Modo traza (env NBA_PROBE_TRACE=1): DR0 graba en silencio (rcx, r8) de cada acierto en
+    // un anillo; DR2 graba el valor de RDI (p. ej. la rutina comun que devuelve un booleano al
+    // script); un acierto en DR1 vuelca el anillo. Sirve para ver que funciones nativas
+    // (adaptador, nombre) llamo el script de la interfaz, y que devolvieron, antes de un evento.
+    // Con NBA_PROBE_DR2=fmt, DR2 se pone en una funcion de log variadica (this, nivel, formato, a,
+    // b, c) y se graba el formato y los tres primeros argumentos.
+    static const bool trace_mode = std::getenv("NBA_PROBE_TRACE") != nullptr;
+    static const bool dr2_fmt = [] {
+        const char* v = std::getenv("NBA_PROBE_DR2");
+        return v != nullptr && std::string_view{v} == "fmt";
+    }();
+    if (trace_mode && g_nba_auto_marks && (dr6 & 0xB)) {
+        // Traza automatica: DR0, DR1 y DR3 son marcas (entrada a una funcion concreta)
+        const bool mark = ((dr6 & 0x1) && rip == ctx->Dr0) || ((dr6 & 0x2) && rip == ctx->Dr1) ||
+                          ((dr6 & 0x8) && rip == ctx->Dr3);
+        if (mark) {
+            // NBA_MARK_ALT=1: en vez de rax/rbx/rcx se guardan [rsp] (direccion de retorno), [rsi] y rdx
+            static const bool alt = std::getenv("NBA_MARK_ALT") != nullptr;
+            std::scoped_lock lk{g_nba_ring_mutex};
+            g_nba_ring[g_nba_ring_pos++ % g_nba_ring.size()] = {3, rip, ctx->Rdi, ctx->Rsi,
+                                                                 GetCurrentThreadId(),
+                                                                 alt ? NbaReadQword(ctx->Rsp) : ctx->Rax,
+                                                                 alt ? NbaReadQword(ctx->Rsi) : ctx->Rbx,
+                                                                 alt ? ctx->Rdx : ctx->Rcx,
+                                                                 NbaReadQword(ctx->Rdi), NbaReadQword(ctx->Rdi + g_nba_mark_offs[0]),
+                                                                 NbaReadQword(ctx->Rdi + g_nba_mark_offs[1]), NbaReadQword(ctx->Rdi + g_nba_mark_offs[2]),
+                                                                 NbaReadQword(ctx->Rdi + g_nba_mark_offs[3])};
+            ctx->Dr6 = 0;
+            ctx->EFlags |= 0x10000;
+            return true;
+        }
+    }
+    if (trace_mode && (dr6 & 0x7) && !(dr6 & 0x8)) {
+        std::scoped_lock lk{g_nba_ring_mutex};
+        auto& ring = g_nba_ring;
+        if ((dr6 & 0x1) && rip == ctx->Dr0) {
+            ring[g_nba_ring_pos++ % ring.size()] = {0, ctx->Rcx, ctx->R8, 0, 0};
+            ctx->Dr6 = 0;
+            ctx->EFlags |= 0x10000;
+            return true;
+        }
+        if ((dr6 & 0x4) && rip == ctx->Dr2) {
+            ring[g_nba_ring_pos++ % ring.size()] =
+                dr2_fmt ? NbaTraceEntry{2, ctx->Rdx, ctx->Rcx, ctx->R8, ctx->R9}
+                        : NbaTraceEntry{1, ctx->Rdi, 0, 0, 0};
+            ctx->Dr6 = 0;
+            ctx->EFlags |= 0x10000;
+            return true;
+        }
+        if ((dr6 & 0x2) && rip == ctx->Dr1) {
+            DumpNbaTrace();
+        }
+    }
+    u64 hits;
+    {
+        std::scoped_lock lk{probe_mutex};
+        hits = ++probe_hits[rip];
+    }
+    const bool verbose = hits <= 30 || (hits % 500) == 0;
+    if (dr6 & 0x8) {
+        // Retorno capturado: desactivar DR3
+        if (verbose) {
+            LOG_INFO(Debug, "NBA-PROBE ret at={:#x} rax={:#x} hits={}", rip, ctx->Rax, hits);
+        }
+        ctx->Dr7 &= ~((u64)0x3 << 6);
+        ctx->Dr7 &= ~((u64)0xF << 28);
+        ctx->Dr3 = 0;
+    } else {
+        if (verbose) {
+            const u64* sp = reinterpret_cast<const u64*>(ctx->Rsp);
+            std::string chain;
+            u64 rbp = ctx->Rbp;
+            for (int i = 0; i < 6; i++) {
+                if (rbp < ctx->Rsp || rbp > ctx->Rsp + 0x100000 || (rbp & 7)) {
+                    break;
+                }
+                const u64* fp = reinterpret_cast<const u64*>(rbp);
+                chain += fmt::format(" {:#x}", fp[1]);
+                rbp = fp[0];
+            }
+            // 32 bytes at rbx and at rdi (when readable): the structure a loop is walking, or
+            // the object a method was called on
+            const auto dump = [](u64 addr) {
+                std::string mem;
+                MEMORY_BASIC_INFORMATION mbi{};
+                if (addr >= 0x10000 &&
+                    VirtualQuery(reinterpret_cast<void*>(addr), &mbi, sizeof(mbi)) != 0 &&
+                    mbi.State == MEM_COMMIT && (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) == 0 &&
+                    addr + 32 <= reinterpret_cast<u64>(mbi.BaseAddress) + mbi.RegionSize) {
+                    const auto* p = reinterpret_cast<const u8*>(addr);
+                    for (int i = 0; i < 32; i++) {
+                        mem += fmt::format("{:02x}", p[i]);
+                    }
+                }
+                return mem;
+            };
+            LOG_INFO(Debug,
+                     "NBA-PROBE hit at={:#x} hits={} rdi={:#x} rsi={:#x} rdx={:#x} rcx={:#x} "
+                     "rax={:#x} rbx={:#x} r8={:#x} r9={:#x} r12={:#x} r13={:#x} r14={:#x} "
+                     "r15={:#x} [rbx]={} [rdi]={} ret={:#x} chain:{}",
+                     rip, hits, ctx->Rdi, ctx->Rsi, ctx->Rdx, ctx->Rcx, ctx->Rax, ctx->Rbx,
+                     ctx->R8, ctx->R9, ctx->R12, ctx->R13, ctx->R14, ctx->R15, dump(ctx->Rbx),
+                     dump(ctx->Rdi), sp[0], chain);
+        }
+        // Armar DR3 sobre la direccion de retorno (ejecucion, 1 byte)
+        if ((ctx->Dr7 & ((u64)0x3 << 6)) == 0) {
+            ctx->Dr3 = *reinterpret_cast<const u64*>(ctx->Rsp);
+            ctx->Dr7 &= ~((u64)0xF << 28);
+            ctx->Dr7 |= ((u64)0x1 << 6);
+        }
+    }
+    ctx->Dr6 = 0;
+    ctx->EFlags |= 0x10000; // RF
+    return true;
+}
